{
  "name": "keyframe-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser-based motion graphics and compositing editor: comps, layers, keyframes, effects, precomps, track mattes, motion blur and export.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
